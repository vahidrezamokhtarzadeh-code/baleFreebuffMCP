# Bale Bot Token (from @BotFather in Bale)
BALE_BOT_TOKEN=your_bot_token_here

# Comma-separated user IDs to allow (empty = all users allowed)
ALLOWED_USERS=

# Path to freebuff executable
FREEBUFF_PATH=freebuff

# Freebuff working directory
FREEBUFF_WORKING_DIR=/home/user/my-project

# Session timeout in milliseconds (default: 30 min = 1800000)
SESSION_TIMEOUT_MS=1800000

# Max output length per message (Bale limit is ~4096 chars)
MAX_OUTPUT_LENGTH=3500

# Long-poll timeout in seconds
POLL_TIMEOUT=30
